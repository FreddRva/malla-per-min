#define RELAY_D14 14 
#define RELAY_D18 18 
#define RELAY_D19 19 
#define RELAY_D32 32 
#define RELAY_D33 33 
#define RELAY_D21 21 

WebServer server(80);

void enableCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
}

void relay25On() {
  digitalWrite(RELAY_D25, LOW);
  enableCORS();
  server.send(200, "application/json", "{\"success\":true}");
}

void relay25Off() {
  digitalWrite(RELAY_D25, HIGH);
  enableCORS();
  server.send(200, "application/json", "{\"success\":true}");
