void relaysOn() {

  digitalWrite(RELAY_D25, LOW);
  digitalWrite(RELAY_D26, LOW);
  digitalWrite(RELAY_D27, LOW);
  digitalWrite(RELAY_D14, LOW);
  digitalWrite(RELAY_D18, LOW);
  digitalWrite(RELAY_D19, LOW);
  digitalWrite(RELAY_D32, LOW);
  digitalWrite(RELAY_D33, LOW);
  digitalWrite(RELAY_D21, LOW);

  enableCORS();

  server.send(
    200,
    "application/json",
    "{\"success\":true,\"message\":\"Todos encendidos rápido\"}"
  );
}


void relaysOff() {

  digitalWrite(RELAY_D25, HIGH);
  digitalWrite(RELAY_D26, HIGH);
  digitalWrite(RELAY_D27, HIGH);
  digitalWrite(RELAY_D14, HIGH);
  digitalWrite(RELAY_D18, HIGH);
  digitalWrite(RELAY_D19, HIGH);
  digitalWrite(RELAY_D32, HIGH);
  digitalWrite(RELAY_D33, HIGH);
  digitalWrite(RELAY_D21, HIGH);

